// PKGPATH: gno.land/r/aib/main
package main

// The base denom comes from the counterparty and is only checked for slashes:
// the Home page must render it as escaped table-cell text, so markdown in it
// (a pipe closing the cell, a link with entity-encoded slashes, backticks)
// cannot forge realm content.

import (
	"encoding/base64"
	"encoding/hex"
	"time"

	"gno.land/p/aib/ibc/ics20/v0"
	tmtesting "gno.land/p/aib/ibc/lightclient/tendermint/testing/v0"
	"gno.land/p/aib/ibc/types/v0"
	"gno.land/p/aib/ics23/v0"
	"gno.land/p/nt/testutils/v0"
	"gno.land/r/aib/ibc/apps/transfer"
	_ "gno.land/r/aib/ibc/apps/transfer/impl/v0"
	"gno.land/r/aib/ibc/core"
	_ "gno.land/r/aib/ibc/core/impl/v0"
)

const (
	baseDenom = "u`x`|[send](&#47;r&#47;evil$help&func=Send)"
	amount    = "100"
)

func main(cur realm) {
	var (
		chainID       = "chain-id-2"
		trustedHeight = types.NewHeight(2, 2)
		clientState   = tmtesting.NewClientState(chainID, trustedHeight)
		// NOTE this apphash was provided by the gen-proof command below.
		apphash, _     = hex.DecodeString("28ebd37750fba682b28a730b615853ab14e970df51d0be8256e8147f919d5ce4")
		trustedValset  = tmtesting.GenValset()
		consensusState = tmtesting.GenConsensusState(time.Now(), apphash, trustedValset.Hash())
		counterpartyID = "07-tendermint-42"
	)
	clientID := core.CreateClient(cross(cur), clientState, consensusState)
	core.RegisterCounterparty(cross(cur), clientID, [][]byte{[]byte("iavlStoreKey"), []byte("prefix2")}, counterpartyID)

	receiver := testutils.TestAddress("receiver")
	recvPayload := ics20.NewFungibleTokenPacketData(baseDenom, amount, "atone1user", receiver.String(), "")
	recvPayloadBz := recvPayload.ProtoMarshal()
	// NOTE this base64 value is used in payload.value in the gen-proof command below.
	println("Payload proto:", base64.StdEncoding.EncodeToString(recvPayloadBz))

	specs := ics23.IavlSpec()
	// NOTE code generated by:
	// go run -C ./cmd/gen-proof . 'prefix2' '07-tendermint-42' 'packet' '{"sequence":1,"source_client":"07-tendermint-42","destination_client":"07-tendermint-1","timeout_timestamp":1234571490,"payloads":[{"source_port":"transfer","destination_port":"transfer","encoding":"application/x-protobuf","value":"Cit1YHhgfFtzZW5kXSgmIzQ3O3ImIzQ3O2V2aWwkaGVscCZmdW5jPVNlbmQpEgMxMDAaCmF0b25lMXVzZXIiKGcxd2Zqa3hldGZ3ZWpoeWg2bHRhMDQ3aDZsdGEwNDdoNmxsbTgyeWw=","version":"ics20-1"}]}'
	recvProof := []ics23.CommitmentProof{

		// iavl proof
		ics23.CommitmentProof_Exist{
			Exist: &ics23.ExistenceProof{
				Key:   []byte("\x70\x72\x65\x66\x69\x78\x32\x30\x37\x2d\x74\x65\x6e\x64\x65\x72\x6d\x69\x6e\x74\x2d\x34\x32\x01\x00\x00\x00\x00\x00\x00\x00\x01"),
				Value: []byte("\x4a\x33\x51\x7c\x90\xe0\xdb\xf5\xbf\x39\xc0\x98\x02\x90\x31\x74\xa0\x1a\x6c\xb9\xd5\xce\x1c\x61\x16\xec\x19\x8a\x1f\xc6\x10\x00"),
				Leaf: &ics23.LeafOp{
					Hash:         specs.LeafSpec.Hash,
					PrehashKey:   specs.LeafSpec.PrehashKey,
					PrehashValue: specs.LeafSpec.PrehashValue,
					Length:       specs.LeafSpec.Length,
					Prefix:       []byte("\x00\x02\x02"),
				},
				Path: []*ics23.InnerOp{
					{
						Hash:   specs.InnerSpec.Hash,
						Prefix: []byte("\x02\x04\x02\x20\x35\xf8\xea\x80\x53\x90\xe0\x84\x85\x4f\x39\x9b\x42\xcc\xde\xae\xa3\x3a\x1d\xed\xc1\x15\x63\x8a\xc4\x8d\x06\x00\x63\x7d\xba\x1f\x20"),
						Suffix: []byte(""),
					},
					{
						Hash:   specs.InnerSpec.Hash,
						Prefix: []byte("\x04\x08\x02\x20"),
						Suffix: []byte("\x20\x79\x8e\x2c\xaa\x96\xfd\xfb\xa3\x76\xdd\xeb\x47\x99\x99\x54\xd2\xf4\x7e\x65\x16\x22\x64\xb0\x53\x6a\xb5\xdf\xf7\xfc\x0a\x2e\x07"),
					},
					{
						Hash:   specs.InnerSpec.Hash,
						Prefix: []byte("\x06\x0c\x02\x20\x9a\xf3\x7d\xd5\x95\xa0\x19\x08\x03\xb5\xe0\x5a\xae\xf4\x2a\xe3\xfa\xd4\x99\xe4\xfb\xe3\x7f\x7c\xd3\x1c\xad\xff\x22\xa9\xee\x74\x20"),
						Suffix: []byte(""),
					},
				},
			},
		},

		// rootmulti proof
		ics23.CommitmentProof_Exist{
			Exist: &ics23.ExistenceProof{
				Key:   []byte("\x69\x61\x76\x6c\x53\x74\x6f\x72\x65\x4b\x65\x79"),
				Value: []byte("\x90\xf7\xa2\xe6\xd7\x82\x06\x15\x1d\x0e\x48\xe3\xeb\x85\x76\x1a\xbc\x2f\x32\x16\xb8\xd8\x22\x2d\xd8\xe6\x9d\xbe\x08\xf4\xa5\x97"),
				Leaf: &ics23.LeafOp{
					Hash:         specs.LeafSpec.Hash,
					PrehashKey:   specs.LeafSpec.PrehashKey,
					PrehashValue: specs.LeafSpec.PrehashValue,
					Length:       specs.LeafSpec.Length,
					Prefix:       []byte("\x00"),
				},
				Path: []*ics23.InnerOp{},
			},
		},
	}

	recvPacket := types.MsgRecvPacket{
		Packet: types.Packet{
			Sequence:          1,
			SourceClient:      counterpartyID,
			DestinationClient: clientID,
			TimeoutTimestamp:  uint64(time.Now().Add(time.Hour).Unix()),
			Payloads: []types.Payload{{
				SourcePort:      transfer.PortID,
				DestinationPort: transfer.PortID,
				Encoding:        transfer.EncodingProtobuf,
				Value:           recvPayloadBz,
				Version:         transfer.V1,
			}},
		},
		ProofCommitment: recvProof,
		ProofHeight:     trustedHeight,
	}
	core.RecvPacket(cross(cur), recvPacket)

	println(transfer.Render(""))
}

// Output:
// Payload proto: Cit1YHhgfFtzZW5kXSgmIzQ3O3ImIzQ3O2V2aWwkaGVscCZmdW5jPVNlbmQpEgMxMDAaCmF0b25lMXVzZXIiKGcxd2Zqa3hldGZ3ZWpoeWg2bHRhMDQ3aDZsdGEwNDdoNmxsbTgyeWw=
// # IBC transfer
//
// ICS-20 style transfer state and voucher token queries.
//
// **Upgradeable realm**: the ICS-20 logic runs in the implementation [`gno.land/r/aib/ibc/apps/transfer/impl/v1`](/r/aib/ibc/apps/transfer/impl/v1) (version v1), replaceable by the authority with `UpdateImpl` (see [`admin`](/r/aib/ibc/apps/transfer:admin)).
//
// ## Transfer
//
// Trigger an IBC transfer from your wallet. Pick the client of the destination chain:
//
// - [send via `07-tendermint-1`](/r/aib/main$help&func=Transfer&amount=&clientID=07-tendermint-1&denom=&memo=&receiver=&timeoutTimestamp=1234571490) — Active, trusted height `2/2` ([client details](/r/aib/ibc/core:clients/07-tendermint-1))
//
// ## Vouchers (1)
//
// | Denom | Base | Path | Supply | GRC20 | Actions |
// |-------|------|------|--------|-------|---------|
// | [`ibc/DBBF…4DAB`](/r/aib/ibc/apps/transfer:denoms/ibc/DBBF2B32893BFB0A7CEAEAEE8A9AD6A5D112FBC2C3B36E6F0BB0902DDD054DAB) | u\`x\`\|\[send\]\(\&\#47;r\&\#47;evil&#36;help\&func=Send\) | transfer/07\-tendermint\-1/u\`x\`\|\[send\]\(\&\#47;r\&\#47;evil&#36;help\&func=Send\) | [100](/r/aib/ibc/apps/transfer:voucher/ibc/DBBF2B32893BFB0A7CEAEAEE8A9AD6A5D112FBC2C3B36E6F0BB0902DDD054DAB) | [gno.land/r/aib/ibc/apps/transfer.IBC-1](/r/nt/grc20reg/v0:gno.land/r/aib/ibc/apps/transfer.IBC-1) | [send back](/r/aib/main$help&func=Transfer&amount=&clientID=07-tendermint-1&denom=ibc%2FDBBF2B32893BFB0A7CEAEAEE8A9AD6A5D112FBC2C3B36E6F0BB0902DDD054DAB&memo=&receiver=&timeoutTimestamp=1234571490) via `07-tendermint-1` — [send](/r/aib/main$help&func=VoucherSend&amount=&ibcDenom=ibc%2FDBBF2B32893BFB0A7CEAEAEE8A9AD6A5D112FBC2C3B36E6F0BB0902DDD054DAB&to=) — [approve](/r/aib/main$help&func=VoucherApprove&amount=&ibcDenom=ibc%2FDBBF2B32893BFB0A7CEAEAEE8A9AD6A5D112FBC2C3B36E6F0BB0902DDD054DAB&spender=) |
//
// ## Escrow (0)
//
// No escrow yet.
//
// ## JSON endpoints
//
// - [`admin`](/r/aib/ibc/apps/transfer:admin): authority, pause state, blocked addresses
// - [`denoms`](/r/aib/ibc/apps/transfer:denoms): list known IBC denoms (`?page`, `?limit`)
// - `denoms/ibc/{hash}`: get metadata for an IBC denom
// - `total_escrow/{denom}`: get total escrow tracked for a base denom
// - [`vouchers`](/r/aib/ibc/apps/transfer:vouchers): list voucher tokens (`?page`, `?limit`)
// - `voucher/ibc/{hash}`: get voucher token metadata
// - `voucher/ibc/{hash}/balance/{addr}`: get a voucher balance for an address
//
//
// ## Ethereum routes
//
// No route enrolled: Ethereum clients carry no transfer.
